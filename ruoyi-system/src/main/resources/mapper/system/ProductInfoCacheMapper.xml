<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ProductInfoCacheMapper">
    <resultMap type="ProductInfoCache" id="ProductInfoCacheResult">
        <result property="platform" column="platform"/>
        <result property="itemId" column="item_id"/>
        <result property="title" column="title"/>
        <result property="mainImages" column="main_images"/>
        <result property="detailImages" column="detail_images"/>
        <result property="priceText" column="price_text"/>
        <result property="categoryName" column="category_name"/>
        <result property="shopUrl" column="shop_url"/>
        <result property="sales" column="sales"/>
        <result property="commentCount" column="comment_count"/>
        <result property="fetchedTime" column="fetched_time"/>
    </resultMap>

    <sql id="selectProductInfoCacheVo">
        select platform, item_id, title, main_images, detail_images, price_text, category_name, shop_url, sales, comment_count, fetched_time
        from product_info_cache
    </sql>

    <select id="selectProductInfoCache" parameterType="ProductInfoCache" resultMap="ProductInfoCacheResult">
        <include refid="selectProductInfoCacheVo"/>
        where platform = #{platform} and item_id = #{itemId}
    </select>

    <insert id="insertProductInfoCache" parameterType="ProductInfoCache">
        insert into product_info_cache
        (platform, item_id, title, main_images, detail_images, price_text, category_name, shop_url, sales, comment_count, fetched_time)
        values
        (#{platform}, #{itemId}, #{title}, #{mainImages}, #{detailImages}, #{priceText}, #{categoryName}, #{shopUrl}, #{sales}, #{commentCount}, #{fetchedTime})
        on duplicate key update item_id = item_id
    </insert>
</mapper>
